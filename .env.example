# Copy this file to .env and fill in the four required keys:
#
#     cp .env.example .env
#
# .env is gitignored -- never commit real keys. If these variables are already
# exported in your shell, that works too: python-dotenv does not override them.

# --- Required ------------------------------------------------------------------

# TypeSafe System One, used by the "TypeSafe System One" guardrail engine.
# https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Powers the agent itself, and the "LLM-as-judge" guardrail engine.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Arize AX, for tracing. Both values are on the Space settings page.
# https://app.arize.com
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# --- Optional ------------------------------------------------------------------

# Pin the TypeSafe model instead of tracking the latest release.
# TYPESAFE_MODEL=jev-latest

# The model behind the LLM-as-judge engine. Wants the smallest and fastest model
# your provider offers, since the guardrail runs on every hop.
# GUARDRAIL_LLM_MODEL=gpt-5.4-nano
